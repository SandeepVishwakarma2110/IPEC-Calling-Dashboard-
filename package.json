{
    "name": "ipec-dashboard",
    "version": "2.0.0",
    "main": "server.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
        "dev:server": "nodemon server.js",
        "dev:frontend": "cd frontend && npm run dev",
        "build": "npm install --prefix frontend && npm run build --prefix frontend",
        "postinstall": "npm install --prefix frontend && npm run build --prefix frontend",
        "start": "node server.js",
        "start:prod": "npm run build && node server.js"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.0"
    }
}